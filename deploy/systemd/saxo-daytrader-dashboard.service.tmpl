[Unit]
Description=Saxo Daytrader Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
Environment=PYTHONUNBUFFERED=1
ExecStart={{PYTHON_BIN}} {{PROJECT_DIR}}/main.py --headless --no-browser --port {{PORT}}
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
